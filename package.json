{
  "name": "hangar01",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "node scripts/generate-aircraft-index.mjs",
    "prebuild": "node scripts/generate-aircraft-index.mjs",
    "pretypecheck": "node scripts/generate-aircraft-index.mjs",
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "index:generate": "node scripts/generate-aircraft-index.mjs",
    "validate:checklists": "node scripts/validate-checklists.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:a11y": "playwright test",
    "test:a11y:ui": "playwright test --ui",
    "test:a11y:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "seo:check": "node scripts/seo-check.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.10.1",
    "@vercel/speed-insights": "^1.3.1",
    "framer-motion": "^12.25.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "24.19.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vercel/node": "16.0.1",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "postcss": "^8.5.6",
    "prettier": "3.9.9",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "typescript-eslint": "8.70.1",
    "vite": "^6.2.0",
    "vitest": "5.0.2"
  },
  "overrides": {
    "zod": "^4.6.7"
  }
}
